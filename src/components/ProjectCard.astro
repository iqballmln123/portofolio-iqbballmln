---
import ChapterNumber from './ChapterNumber.astro';

interface Props {
  chapter: string;
  title: string;
  problem: string;
  process: string;
  result: string;
  tools: string;
  images: { src: string; alt: string }[];
  reverse?: boolean;
}

const {
  chapter,
  title,
  problem,
  process,
  result,
  tools,
  images,
  reverse = false,
} = Astro.props;

const toolsList = tools.split(',').map((t) => t.trim());
// Duplicate tools list to ensure smooth infinite marquee scroll
const marqueeTools = [...toolsList, ...toolsList, ...toolsList, ...toolsList];
---

<article class="project-article stacked-card">
  <div class="project-card-inner">
    <div class={`project-grid ${reverse ? 'project-grid--reverse' : ''}`}>
      
      <!-- Sticky Media Gallery Column -->
      <div class="project-media-sticky">
        <project-gallery>
          <div class="gallery-container">
            <!-- Embla Viewport -->
            <div class="embla__viewport" data-embla-viewport>
              <div class="embla__container">
                {images.map((img, idx) => (
                  <div class="embla__slide">
                    <div class="slide-inner">
                      <img src={img.src} alt={img.alt} loading={idx === 0 ? "eager" : "lazy"} />
                    </div>
                  </div>
                ))}
              </div>
            </div>
            
            <!-- Gallery Controls -->
            {images.length > 1 && (
              <div class="gallery-controls">
                <div class="gallery-indicator" data-indicator>
                  1 / {images.length}
                </div>
                <div class="gallery-nav">
                  <button class="nav-btn" data-prev aria-label="Previous image">←</button>
                  <button class="nav-btn" data-next aria-label="Next image">→</button>
                </div>
              </div>
            )}
          </div>
        </project-gallery>
      </div>

      <!-- Scrolling Narrative Text Column -->
      <div class="project-content-scroll">
        <div class="project-header">
          <ChapterNumber number={chapter} />
          <h2 class="headline headline--section project-title">{title}</h2>
        </div>

        <div class="project-details">
          <div class="detail-block">
            <h3 class="detail-label">Masalah</h3>
            <p>{problem}</p>
          </div>

          <div class="detail-block">
            <h3 class="detail-label">Proses</h3>
            <p>{process}</p>
          </div>

          <div class="detail-block">
            <h3 class="detail-label">Hasil</h3>
            <p>{result}</p>
          </div>
        </div>

        <!-- Tech Stack Infinite Marquee Ticker -->
        <div class="project-marquee-wrapper">
          <span class="marquee-label text-mono-sm text-secondary">Tech Stack</span>
          <div class="marquee-container">
            <div class="marquee-track">
              {marqueeTools.map((tool) => (
                <span class="tool-tag">{tool}</span>
              ))}
            </div>
          </div>
        </div>

      </div>
    </div>
  </div>
</article>

<style>
  .project-article {
    padding: var(--space-6);
  }

  @media (min-width: 768px) {
    .project-article {
      padding: var(--space-8);
    }
  }

  .project-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  @media (min-width: 768px) {
    .project-grid {
      grid-template-columns: 1.2fr 1fr;
      gap: var(--space-8);
      align-items: start;
    }

    .project-grid--reverse {
      grid-template-columns: 1fr 1.2fr;
    }

    .project-grid--reverse > .project-media-sticky {
      order: 2;
    }

    .project-grid--reverse > .project-content-scroll {
      order: 1;
    }
  }

  /* ── Sticky Image Column (Desktop) ── */
  @media (min-width: 768px) {
    .project-media-sticky {
      position: sticky;
      top: 8rem;
      z-index: 2;
    }
  }

  .gallery-container {
    position: relative;
    border: 1px solid var(--color-border);
    background-color: var(--color-bg);
    display: flex;
    flex-direction: column;
    border-radius: 4px;
    overflow: hidden;
  }

  .embla__viewport {
    overflow: hidden;
  }

  .embla__container {
    display: flex;
  }

  .embla__slide {
    flex: 0 0 100%;
    min-width: 0;
  }

  .slide-inner {
    height: 380px; 
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: var(--color-bg-alt);
    padding: var(--space-3);
  }

  @media (min-width: 768px) {
    .slide-inner {
      height: 440px;
    }
  }

  .slide-inner img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  /* Controls */
  .gallery-controls {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--space-2) var(--space-4);
    border-top: 1px solid var(--color-border);
    font-family: var(--font-mono);
    font-size: var(--text-meta-sm);
    color: var(--color-text-sec);
    letter-spacing: var(--ls-mono);
    background-color: var(--color-surface);
  }

  .gallery-nav {
    display: flex;
    gap: var(--space-1);
  }

  .nav-btn {
    background: none;
    border: 1px solid var(--color-border);
    cursor: pointer;
    padding: 0.25rem 0.75rem;
    color: var(--color-text);
    transition: all var(--duration-hover) var(--ease-editorial);
    font-family: var(--font-mono);
    border-radius: 2px;
  }

  .nav-btn:hover {
    border-color: var(--color-text);
    background-color: var(--color-bg);
  }

  /* ── Narrative Text Column ── */
  .project-header {
    margin-bottom: var(--space-6);
  }

  .project-title {
    max-width: 24rem;
  }

  .project-details {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .detail-label {
    font-family: var(--font-mono);
    font-size: var(--text-meta-sm);
    letter-spacing: var(--ls-wide);
    text-transform: uppercase;
    color: var(--color-text-sec);
    font-weight: 500;
    margin-bottom: 0.375rem;
    padding-bottom: 0.25rem;
    border-bottom: 1.5px solid var(--color-border-alt);
    display: inline-block;
  }

  .detail-block p {
    max-width: 32rem;
    color: var(--color-text);
    line-height: 1.6;
  }

  /* Marquee Tech Stack */
  .project-marquee-wrapper {
    margin-top: var(--space-8);
    padding-top: var(--space-4);
    border-top: 0.5px solid var(--color-border);
  }

  .marquee-label {
    display: block;
    margin-bottom: var(--space-2);
    text-transform: uppercase;
    letter-spacing: var(--ls-wide);
  }

  .tool-tag {
    font-family: var(--font-mono);
    font-size: var(--text-meta-sm);
    letter-spacing: var(--ls-mono);
    color: var(--color-text);
    border: 1px solid var(--color-border);
    padding: 0.25rem 0.75rem;
    display: inline-block;
    background-color: var(--color-bg);
    border-radius: 100px;
  }
</style>

<script>
  import EmblaCarousel from 'embla-carousel';

  class ProjectGallery extends HTMLElement {
    connectedCallback() {
      const viewportNode = this.querySelector('[data-embla-viewport]') as HTMLElement;
      if (!viewportNode) return;

      const emblaApi = EmblaCarousel(viewportNode, { loop: true });
      
      const prevBtn = this.querySelector('[data-prev]');
      const nextBtn = this.querySelector('[data-next]');
      const indicator = this.querySelector('[data-indicator]');
      
      if (prevBtn) prevBtn.addEventListener('click', () => emblaApi.scrollPrev());
      if (nextBtn) nextBtn.addEventListener('click', () => emblaApi.scrollNext());
      
      const updateIndicator = () => {
        if (indicator) {
          indicator.textContent = `${emblaApi.selectedScrollSnap() + 1} / ${emblaApi.scrollSnapList().length}`;
        }
      };
      
      emblaApi.on('select', updateIndicator);
      emblaApi.on('reInit', updateIndicator);
      updateIndicator();
    }
  }

  if (!customElements.get('project-gallery')) {
    customElements.define('project-gallery', ProjectGallery);
  }
</script>
