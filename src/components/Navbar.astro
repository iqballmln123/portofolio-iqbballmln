---
const navItems = [
  { label: 'Home', href: '#hero' },
  { label: 'Journey', href: '#journey' },
  { label: 'Works', href: '#projects' },
  { label: 'Skills', href: '#skills' },
  { label: 'Contact', href: '#contact' },
];
---

<nav class="floating-nav" aria-label="Main Navigation">
  <ul class="nav-list">
    {navItems.map((item) => (
      <li>
        <a href={item.href} class="nav-link" data-nav-target={item.href.substring(1)}>
          <span class="nav-text">{item.label}</span>
          <span class="nav-line"></span>
        </a>
      </li>
    ))}
  </ul>
</nav>

<style>
  .floating-nav {
    position: fixed;
    top: 1.5rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 100;
    background: var(--glass-bg-strong);
    backdrop-filter: blur(var(--glass-blur-heavy));
    -webkit-backdrop-filter: blur(var(--glass-blur-heavy));
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-pill);
    padding: 0.5rem;
    box-shadow: var(--shadow-lg);
    transition: transform 0.5s var(--ease-out-expo),
                opacity 0.5s ease,
                box-shadow var(--duration-hover) var(--ease-smooth);
    will-change: transform;
  }

  .floating-nav:hover {
    box-shadow: var(--shadow-xl);
  }

  .floating-nav.nav-hidden {
    transform: translateX(-50%) translateY(-120%);
    opacity: 0;
    pointer-events: none;
  }

  .nav-list {
    display: flex;
    gap: 0.25rem;
    list-style: none;
  }

  .nav-link {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 0.625rem 1.25rem;
    border-radius: var(--radius-pill);
    color: var(--color-text-sec);
    font-family: var(--font-mono);
    font-size: var(--text-meta-sm);
    text-transform: uppercase;
    letter-spacing: var(--ls-mono);
    transition: color var(--duration-hover) var(--ease-editorial),
                background-color var(--duration-hover) var(--ease-smooth);
    will-change: transform;
  }

  .nav-link:hover {
    color: var(--color-text);
    background-color: rgba(10, 10, 10, 0.04);
  }

  .nav-link.active {
    color: var(--color-text);
  }

  /* Active indicator line (replaces dot for premium feel) */
  .nav-line {
    width: 0;
    height: 1.5px;
    background-color: var(--color-text);
    position: absolute;
    bottom: 6px;
    border-radius: 1px;
    transition: width 0.4s var(--ease-out-expo);
  }

  .nav-link.active .nav-line {
    width: 16px;
  }

  .nav-link:hover .nav-line {
    width: 10px;
    background-color: var(--color-text-sec);
  }

  .nav-link.active:hover .nav-line {
    width: 16px;
    background-color: var(--color-text);
  }

  @media (max-width: 768px) {
    .floating-nav {
      width: 90%;
      max-width: 420px;
      top: 1rem;
    }
    .nav-link {
      padding: 0.5rem 0.75rem;
      font-size: 0.6rem;
      flex: 1; /* evenly distribute */
    }
    .nav-list {
      justify-content: space-between;
      width: 100%;
    }
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  class FloatingNav {
    nav: HTMLElement | null;
    links: NodeListOf<HTMLElement>;
    sections: HTMLElement[];

    constructor() {
      this.nav = document.querySelector('.floating-nav');
      this.links = document.querySelectorAll('.nav-link');
      this.sections = Array.from(this.links)
        .map(link => document.getElementById(link.getAttribute('data-nav-target') || ''))
        .filter(el => el !== null) as HTMLElement[];
      
      if (!this.nav || this.links.length === 0) return;
      
      this.init();
    }

    init() {
      gsap.registerPlugin(ScrollTrigger);

      // 1. ScrollSpy for Active states
      const observerOptions = {
        root: null,
        rootMargin: '-40% 0px -60% 0px',
        threshold: 0
      };

      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            this.updateActive(entry.target.id);
          }
        });
      }, observerOptions);

      this.sections.forEach(section => observer.observe(section));

      // 2. Auto-hide on scroll down, show on scroll up
      if (this.nav) {
        const navEl = this.nav;
        let lastScrollY = 0;

        ScrollTrigger.create({
          trigger: document.body,
          start: 'top top',
          end: 'bottom bottom',
          onUpdate: (self) => {
            const currentScrollY = window.scrollY;
            const direction = self.direction; // 1 = down, -1 = up

            // Only hide after scrolling past hero (300px threshold)
            if (currentScrollY > 300 && direction === 1) {
              navEl.classList.add('nav-hidden');
            } else {
              navEl.classList.remove('nav-hidden');
            }

            lastScrollY = currentScrollY;
          }
        });
      }

      // 3. Magnetic Effect (Desktop only)
      if (window.matchMedia('(min-width: 768px)').matches && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        this.links.forEach(link => {
          link.addEventListener('mousemove', (e) => this.magneticHover(e, link));
          link.addEventListener('mouseleave', () => this.magneticLeave(link));
        });
      }
    }

    updateActive(id: string) {
      this.links.forEach(link => {
        if (link.getAttribute('data-nav-target') === id) {
          link.classList.add('active');
        } else {
          link.classList.remove('active');
        }
      });
    }

    magneticHover(e: MouseEvent, el: HTMLElement) {
      const rect = el.getBoundingClientRect();
      const x = e.clientX - rect.left - rect.width / 2;
      const y = e.clientY - rect.top - rect.height / 2;

      gsap.to(el, {
        x: x * 0.3,
        y: y * 0.3,
        duration: 0.4,
        ease: 'power2.out',
      });
    }

    magneticLeave(el: HTMLElement) {
      gsap.to(el, {
        x: 0,
        y: 0,
        duration: 0.6,
        ease: 'elastic.out(1, 0.3)',
      });
    }
  }

  // Init
  document.addEventListener('DOMContentLoaded', () => {
    new FloatingNav();
  });
</script>
