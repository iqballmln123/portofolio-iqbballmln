---
import ChapterNumber from './ChapterNumber.astro';
---

<footer id="contact" class="section">
  <div class="grid-line grid-line--h" style="top: 0;" aria-hidden="true"></div>

  <div class="container">
    <div class="contact-layout">
      <div class="reveal">
        <ChapterNumber number="06" label="Contact" />
      </div>

      <div class="contact-content reveal">
        <h2 class="headline headline--hero contact-title">
          Ready to create<br/><em>impact?</em>
        </h2>
        <p class="text-secondary contact-desc">
          Saya selalu terbuka untuk mendiskusikan peluang kerja, proyek kolaborasi, atau sekadar bertukar pikiran mengenai teknologi dan sistem.
        </p>

        <div class="contact-links">
          <a href="mailto:iqballmaulana1233@gmail.com" class="contact-link" data-magnetic>
            <span class="link-label text-mono-sm text-secondary">Email</span>
            <span class="link-value">iqballmaulana1233@gmail.com</span>
            <span class="link-arrow">↗</span>
          </a>

          <a href="https://www.linkedin.com/in/mochamad-iqbal-maulana-077045297/" target="_blank" rel="noopener noreferrer" class="contact-link" data-magnetic>
            <span class="link-label text-mono-sm text-secondary">LinkedIn</span>
            <span class="link-value">Mochamad Iqbal Maulana</span>
            <span class="link-arrow">↗</span>
          </a>
        </div>
      </div>
    </div>

    <div class="footer-bottom reveal">
      <p class="text-mono-sm text-secondary">
        DIRANCANG & DIBANGUN OLEH IQBAL — 2026.
      </p>
      <span class="text-mono-sm text-secondary">
        EOF
      </span>
    </div>
  </div>
</footer>

<style>
  .contact-layout {
    margin-bottom: var(--space-16);
  }

  .contact-content {
    margin-top: var(--space-8);
  }

  .contact-title {
    line-height: 1;
    letter-spacing: -0.03em;
    margin-bottom: var(--space-6);
  }

  .contact-title em {
    font-style: italic;
    color: var(--color-accent);
  }

  .contact-desc {
    max-width: 32rem;
    font-size: 1.125rem;
    line-height: 1.6;
    margin-bottom: var(--space-10);
  }

  .contact-links {
    display: flex;
    flex-direction: column;
    gap: 0;
    border-top: 1px solid var(--color-border);
  }

  .contact-link {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-6) 0;
    border-bottom: 1px solid var(--color-border);
    color: var(--color-text);
    text-decoration: none;
    transition: color var(--duration-hover) var(--ease-editorial);
    position: relative;
  }

  .contact-link:hover {
    color: var(--color-accent);
  }

  .contact-link:hover .link-arrow {
    transform: translate(4px, -4px);
    color: var(--color-accent);
  }

  .link-label {
    min-width: 6rem;
    flex-shrink: 0;
  }

  .link-value {
    font-family: var(--font-headline);
    font-size: clamp(1.25rem, 3vw, 2rem);
    font-weight: 700;
    flex: 1;
  }

  .link-arrow {
    font-size: 1.5rem;
    color: var(--color-text-sec);
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1),
                color var(--duration-hover) var(--ease-editorial);
  }

  .footer-bottom {
    padding-top: var(--space-4);
    padding-bottom: var(--space-8);
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  @media (max-width: 767px) {
    .contact-link {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-2);
      padding: var(--space-4) 0;
    }
    .link-arrow {
      display: none;
    }
  }
</style>
