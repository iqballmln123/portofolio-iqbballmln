---
import ChapterNumber from './ChapterNumber.astro';
---

<footer id="contact" class="section border-top">
  <div class="container">
    <div class="contact-layout">
      <div class="reveal contact-header-row">
        <ChapterNumber number="06" label="Contact" />
        <div class="status-pill-badge live-work-pill">
          <span class="status-dot"></span>
          <span>Available for New Opportunities 2026</span>
        </div>
      </div>

      <div class="contact-content reveal">
        <!-- Kinetic Typography Heading -->
        <h2 class="headline headline--hero contact-title" id="kinetic-contact-title">
          Ready to create<br/><em class="kinetic-skew">impact?</em>
        </h2>
        <p class="text-secondary contact-desc">
          Saya selalu terbuka untuk mendiskusikan peluang kerja, proyek kolaborasi, atau sekadar bertukar pikiran mengenai teknologi dan sistem.
        </p>

        <!-- Magnetic Action Links -->
        <div class="contact-links">
          <button class="contact-link magnetic-btn copy-email-btn" id="copy-email-btn" data-magnetic aria-label="Copy Email Address">
            <span class="link-label text-mono-sm text-secondary">Email</span>
            <span class="link-value">iqballmaulana1233@gmail.com</span>
            <span class="link-copy-badge text-mono-sm">Click to Copy 📋</span>
          </button>

          <a href="https://www.linkedin.com/in/mochamad-iqbal-maulana-077045297/" target="_blank" rel="noopener noreferrer" class="contact-link magnetic-btn" data-magnetic>
            <span class="link-label text-mono-sm text-secondary">LinkedIn</span>
            <span class="link-value">Mochamad Iqbal Maulana</span>
            <span class="link-arrow">↗</span>
          </a>
        </div>
      </div>
    </div>

    <div class="footer-bottom reveal">
      <p class="text-mono-sm text-secondary">
        DIRANCANG & DIBANGUN OLEH IQBAL — 2026.
      </p>
      <span class="text-mono-sm text-secondary">
        EOF
      </span>
    </div>
  </div>
</footer>

<style>
  .contact-layout {
    margin-bottom: var(--space-16);
  }

  .contact-header-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: var(--space-4);
  }

  .live-work-pill {
    padding: 0.35rem 0.85rem;
  }

  .contact-content {
    margin-top: var(--space-8);
  }

  .contact-title {
    line-height: 0.95;
    letter-spacing: -0.03em;
    margin-bottom: var(--space-6);
    will-change: transform;
  }

  .contact-title em {
    font-style: italic;
    color: var(--color-text);
    display: inline-block;
    will-change: transform;
  }

  .contact-desc {
    max-width: 32rem;
    font-size: 1.125rem;
    line-height: 1.6;
    margin-bottom: var(--space-10);
  }

  .contact-links {
    display: flex;
    flex-direction: column;
    gap: 0;
    border-top: 1px solid var(--color-border);
  }

  .contact-link {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-6) 0;
    border-bottom: 1px solid var(--color-border);
    color: var(--color-text);
    text-decoration: none;
    transition: border-color var(--duration-hover) var(--ease-editorial);
    position: relative;
    will-change: transform;
    background: none;
    border-left: none;
    border-right: none;
    border-top: none;
    width: 100%;
    text-align: left;
    cursor: pointer;
  }

  .contact-link:hover {
    border-color: var(--color-text);
  }

  .contact-link:hover .link-arrow {
    transform: translate(6px, -6px);
  }

  .link-label {
    min-width: 6rem;
    flex-shrink: 0;
  }

  .link-value {
    font-family: var(--font-headline);
    font-size: clamp(1.25rem, 3vw, 2rem);
    font-weight: 700;
    flex: 1;
  }

  .link-arrow {
    font-size: 1.5rem;
    color: var(--color-text-sec);
    transition: transform 0.4s var(--ease-out-expo);
  }

  .link-copy-badge {
    padding: 0.35rem 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: 100px;
    background-color: var(--color-bg);
    color: var(--color-text-sec);
    transition: all 0.3s ease;
  }

  .contact-link:hover .link-copy-badge {
    background-color: var(--color-text);
    color: var(--color-bg);
    border-color: var(--color-text);
  }

  .footer-bottom {
    padding-top: var(--space-4);
    padding-bottom: var(--space-8);
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  @media (max-width: 767px) {
    .contact-link {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-2);
      padding: var(--space-4) 0;
    }
    .link-arrow, .link-copy-badge {
      align-self: flex-start;
    }
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  document.addEventListener('DOMContentLoaded', initContactEffects);

  function initContactEffects() {
    gsap.registerPlugin(ScrollTrigger);

    // Click to Copy Email Address Toast Handler
    const copyBtn = document.getElementById('copy-email-btn');
    if (copyBtn) {
      copyBtn.addEventListener('click', () => {
        const email = 'iqballmaulana1233@gmail.com';
        navigator.clipboard.writeText(email).then(() => {
          if ((window as any).showToast) {
            (window as any).showToast('Email address copied to clipboard!');
          }
        }).catch(() => {
          if ((window as any).showToast) {
            (window as any).showToast('Email: ' + email);
          }
        });
      });
    }

    const mm = gsap.matchMedia();

    mm.add(
      {
        isDesktop: '(min-width: 768px)',
        reduceMotion: '(prefers-reduced-motion: reduce)',
      },
      (context) => {
        const { reduceMotion, isDesktop } = context.conditions!;

        // 1. Kinetic Typography on Scroll Velocity
        const kineticEm = document.querySelector('.kinetic-skew');
        if (kineticEm && !reduceMotion) {
          let currentSkew = 0;

          ScrollTrigger.create({
            trigger: '#contact',
            start: 'top bottom',
            end: 'bottom top',
            onUpdate: (self) => {
              const velocity = self.getVelocity();
              const skew = gsap.utils.clamp(-12, 12, velocity / 150);
              if (Math.abs(skew) > Math.abs(currentSkew)) {
                currentSkew = skew;
                gsap.to(kineticEm, {
                  skewX: currentSkew,
                  duration: 0.2,
                  ease: 'power1.out',
                  overwrite: 'auto',
                  onComplete: () => {
                    gsap.to(kineticEm, {
                      skewX: 0,
                      duration: 0.6,
                      ease: 'power2.out',
                    });
                  },
                });
              }
            },
          });
        }

        // 2. Magnetic Button Effect
        if (isDesktop && !reduceMotion) {
          const magneticBtns = document.querySelectorAll('[data-magnetic]');
          magneticBtns.forEach((btn) => {
            const htmlBtn = btn as HTMLElement;

            htmlBtn.addEventListener('mousemove', (e: MouseEvent) => {
              const rect = htmlBtn.getBoundingClientRect();
              const x = e.clientX - rect.left - rect.width / 2;
              const y = e.clientY - rect.top - rect.height / 2;

              gsap.to(htmlBtn, {
                x: x * 0.2,
                y: y * 0.25,
                duration: 0.4,
                ease: 'power2.out',
              });
            });

            htmlBtn.addEventListener('mouseleave', () => {
              gsap.to(htmlBtn, {
                x: 0,
                y: 0,
                duration: 0.6,
                ease: 'elastic.out(1, 0.4)',
              });
            });
          });
        }
      }
    );
  }
</script>
