---
import ChapterNumber from './ChapterNumber.astro';
---
<section id="contact" class="section border-top">
  <div class="container">
    <div class="contact-header reveal">
      <ChapterNumber number="06" label="Get In Touch" />
      <p class="text-secondary" style="margin-top: var(--space-2); max-width: 32rem;">
        Saya terbuka untuk kolaborasi, proyek baru, atau sekedar berbincang tentang teknologi.
      </p>
    </div>

    <form class="contact-form" netlify netlify-honeypot="bot-field" name="contact" method="POST">
      <input type="hidden" name="form-name" value="contact" />
      <p class="hidden" aria-hidden="true">
        <label>Don’t fill this out if you're human: <input name="bot-field" /></label>
      </p>
      <div class="form-grid">
        <input class="form-input" type="text" name="name" placeholder="Nama Anda" required />
        <input class="form-input" type="email" name="email" placeholder="Email Anda" required />
        <textarea class="form-textarea" name="message" rows="4" placeholder="Pesan..." required></textarea>
      </div>
      <button type="submit" class="btn-primary btn-submit">
        Kirim Pesan
        <svg class="btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </button>
    </form>
  </div>
</section>

<style>
  .contact-header {
    margin-bottom: var(--space-8);
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    background: var(--glass-bg-strong);
    backdrop-filter: blur(var(--glass-blur));
    -webkit-backdrop-filter: blur(var(--glass-blur));
    border: 1px solid var(--glass-border);
    padding: var(--space-8);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-md);
    transition: box-shadow var(--duration-lift) var(--ease-out-expo),
                transform var(--duration-lift) var(--ease-out-expo);
  }

  .contact-form:hover {
    box-shadow: var(--shadow-xl);
    transform: translateY(-4px);
  }

  .form-grid {
    display: grid;
    gap: var(--space-4);
    grid-template-columns: 1fr;
  }

  @media (min-width: 600px) {
    .form-grid {
      grid-template-columns: 1fr 1fr;
    }
    textarea.form-textarea { grid-column: span 2; }
  }

  .form-input,
  .form-textarea {
    width: 100%;
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    background: rgba(255,255,255,0.85);
    color: var(--color-text);
    font-family: var(--font-mono);
    transition: border-color var(--duration-hover) var(--ease-editorial),
                box-shadow var(--duration-hover) var(--ease-out-expo);
  }

  .form-input:focus,
  .form-textarea:focus {
    outline: none;
    border-color: var(--color-text);
    box-shadow: 0 0 0 3px rgba(0,0,0,0.05);
  }

  .btn-primary {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    background: var(--color-primary);
    color: var(--color-bg);
    padding: var(--space-3) var(--space-5);
    border: none;
    border-radius: var(--radius-pill);
    font-weight: 600;
    cursor: pointer;
    transition: background var(--duration-hover) var(--ease-editorial),
                transform var(--duration-lift) var(--ease-out-expo);
  }

  .btn-primary:hover {
    background: var(--color-primary-dark);
    transform: translateY(-2px);
  }

  .btn-icon {
    width: 1rem;
    height: 1rem;
    stroke-width: 2;
    transition: transform var(--duration-hover) var(--ease-out-expo);
  }

  .btn-primary:hover .btn-icon {
    transform: translateX(4px);
  }
</style>
