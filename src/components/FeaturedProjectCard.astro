---
import ChapterNumber from './ChapterNumber.astro';

interface Props {
  slug: string;
  chapter: string;
  title: string;
  tagline: string;
  tools: string;
  coverImage: string;
}

const { slug, chapter, title, tagline, tools, coverImage } = Astro.props;
const toolsList = tools.split(',').map((t) => t.trim());
---

<a href={`/projects/${slug}`} class="featured-card-link reveal">
  <article class="featured-card">
    <!-- Visual Image Cover with Hover Zoom -->
    <div class="card-cover-wrapper">
      <img src={coverImage} alt={title} loading="lazy" class="card-cover-img" />
      <div class="card-cover-overlay"></div>
      <span class="card-cta-badge text-mono-sm">
        Lihat Case Study <span class="arrow">↗</span>
      </span>
    </div>

    <!-- Content Details -->
    <div class="card-body">
      <div class="card-header">
        <ChapterNumber number={chapter} />
        <h3 class="card-title">{title}</h3>
      </div>
      <p class="card-tagline text-secondary">{tagline}</p>

      <!-- Tech Stack Tags -->
      <div class="card-tags">
        {toolsList.map((tool) => (
          <span class="tool-pill text-mono-sm">{tool}</span>
        ))}
      </div>
    </div>
  </article>
</a>

<style>
  .featured-card-link {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .featured-card {
    background: var(--glass-bg-strong);
    backdrop-filter: blur(var(--glass-blur));
    -webkit-backdrop-filter: blur(var(--glass-blur));
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-card);
    overflow: hidden;
    height: 100%;
    display: flex;
    flex-direction: column;
    box-shadow: var(--shadow-sm);
    transition: border-color 0.35s var(--ease-editorial),
                transform var(--duration-lift) var(--ease-out-expo),
                box-shadow var(--duration-lift) var(--ease-out-expo);
  }

  .featured-card-link:hover .featured-card {
    border-color: rgba(10, 10, 10, 0.2);
    transform: translateY(-8px);
    box-shadow: var(--shadow-xl);
  }

  /* Cover Image System */
  .card-cover-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background-color: var(--color-bg-alt);
  }

  .card-cover-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 0.6s var(--ease-out-expo),
                filter 0.6s var(--ease-out-expo);
  }

  .featured-card-link:hover .card-cover-img {
    transform: scale(1.06);
    filter: brightness(1.03);
  }

  .card-cover-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(10, 10, 10, 0.3) 0%, transparent 60%);
    opacity: 0.4;
    transition: opacity 0.35s ease;
  }

  .featured-card-link:hover .card-cover-overlay {
    opacity: 0.1;
  }

  .card-cta-badge {
    position: absolute;
    bottom: 1rem;
    right: 1rem;
    background: var(--glass-bg-strong);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid var(--glass-border);
    padding: 0.375rem 0.875rem;
    border-radius: var(--radius-pill);
    color: var(--color-text);
    display: flex;
    align-items: center;
    gap: 0.375rem;
    transition: all 0.35s var(--ease-out-expo);
    box-shadow: var(--shadow-md);
    transform: scale(1);
  }

  .featured-card-link:hover .card-cta-badge {
    background-color: var(--color-text);
    color: var(--color-bg);
    border-color: var(--color-text);
    transform: scale(1.05);
    box-shadow: var(--shadow-lg);
  }

  .featured-card-link:hover .card-cta-badge .arrow {
    transform: translate(2px, -2px);
  }

  .arrow {
    display: inline-block;
    transition: transform 0.3s var(--ease-spring);
  }

  /* Body Content */
  .card-body {
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .card-header {
    margin-bottom: var(--space-3);
  }

  .card-title {
    font-family: var(--font-headline);
    font-size: clamp(1.25rem, 2vw, 1.5rem);
    font-weight: 700;
    line-height: 1.25;
    color: var(--color-text);
    margin-top: 0.25rem;
  }

  .card-tagline {
    font-size: 0.9375rem;
    line-height: 1.6;
    margin-bottom: var(--space-6);
    flex: 1;
  }

  .card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin-top: auto;
  }

  .tool-pill {
    background-color: rgba(10, 10, 10, 0.03);
    border: 1px solid var(--color-border);
    padding: 0.25rem 0.625rem;
    border-radius: var(--radius-pill);
    color: var(--color-text-sec);
    transition: background-color var(--duration-hover) var(--ease-smooth),
                color var(--duration-hover) var(--ease-smooth),
                border-color var(--duration-hover) var(--ease-smooth);
  }

  .tool-pill:hover {
    background-color: var(--color-text);
    color: var(--color-bg);
    border-color: var(--color-text);
  }
</style>
