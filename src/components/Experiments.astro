---
import ChapterNumber from './ChapterNumber.astro';

interface Experiment {
  title: string;
  desc: string;
  imageSrc: string;
  imageAlt: string;
}

const experiments: Experiment[] = [
  {
    title: '3D Modeling — Blender',
    desc: 'Desain furniture dan model Lego menggunakan Blender.',
    imageSrc: '/images/experiments/blender-lego.png',
    imageAlt: 'Model Lego 3D — Blender',
  },
  {
    title: 'TikTok Filters',
    desc: 'Filter AR custom: topi dengan layar mirroring, beauty filter, dan game concept.',
    imageSrc: '/images/experiments/tiktok-filter.png',
    imageAlt: 'Poster filter TikTok — AR effect',
  },
  {
    title: 'AR Experiences',
    desc: 'Karakter 3D dan Space Helmet yang bisa digerakkan dan di-resize dalam augmented reality.',
    imageSrc: '/images/experiments/blender-furniture.png',
    imageAlt: 'Furniture 3D — Blender',
  },
];
---

<section id="experiments" class="section">
  <div class="container">
    <div class="exp-header reveal">
      <ChapterNumber number="05" label="Experiments" />
      <p class="text-secondary" style="margin-top: var(--space-2); max-width: 32rem;">
        Eksplorasi kreatif di luar domain utama — 3D modeling, augmented reality, dan creative tools.
      </p>
    </div>

    <div class="exp-grid">
      {experiments.map((exp) => (
        <div class="exp-item reveal">
          <div class="exp-thumb">
            <img src={exp.imageSrc} alt={exp.imageAlt} loading="lazy" />
            <div class="exp-overlay">
              <div class="exp-overlay-content">
                <h3 class="exp-overlay-title">{exp.title}</h3>
                <p class="exp-overlay-desc">{exp.desc}</p>
              </div>
            </div>
          </div>
          <div class="exp-info">
            <h3 class="exp-title">{exp.title}</h3>
            <p class="text-secondary">{exp.desc}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .exp-header {
    margin-bottom: var(--space-8);
  }

  .exp-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
  }

  @media (min-width: 768px) {
    .exp-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .exp-item {
    border-top: 0.5px solid var(--color-border);
    padding: var(--space-4);
    transition: background-color var(--duration-hover) var(--ease-editorial);
  }

  .exp-item:last-child {
    border-bottom: 0.5px solid var(--color-border);
  }

  @media (min-width: 768px) {
    .exp-item:not(:last-child) {
      border-right: 0.5px solid var(--color-border);
    }

    .exp-item:nth-last-child(-n+3) {
      border-bottom: 0.5px solid var(--color-border);
    }

    .exp-item {
      padding: var(--space-4) var(--space-4);
    }

    .exp-item:first-child {
      padding-left: 0;
    }

    .exp-item:last-child {
      padding-right: 0;
    }
  }

  .exp-item:hover {
    background-color: rgba(10, 10, 10, 0.015);
  }

  /* Thumbnail with glassmorphism overlay */
  .exp-thumb {
    position: relative;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    margin-bottom: var(--space-3);
    border: 0.5px solid var(--color-border);
    border-radius: var(--radius-card);
    background-color: #E8E4DC;
  }

  .exp-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--ease-out-expo),
                filter 0.6s var(--ease-out-expo);
  }

  .exp-item:hover .exp-thumb img {
    transform: scale(1.06);
    filter: brightness(0.85);
  }

  /* Glassmorphism overlay on hover */
  .exp-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: flex-end;
    padding: var(--space-4);
    opacity: 0;
    transition: opacity 0.4s var(--ease-out-expo);
  }

  .exp-item:hover .exp-overlay {
    opacity: 1;
  }

  .exp-overlay-content {
    background: var(--glass-bg-strong);
    backdrop-filter: blur(var(--glass-blur));
    -webkit-backdrop-filter: blur(var(--glass-blur));
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-card);
    padding: var(--space-3);
    width: 100%;
    transform: translateY(8px);
    transition: transform 0.4s var(--ease-out-expo);
    box-shadow: var(--shadow-md);
  }

  .exp-item:hover .exp-overlay-content {
    transform: translateY(0);
  }

  .exp-overlay-title {
    font-family: var(--font-headline);
    font-weight: 700;
    font-size: 0.9375rem;
    line-height: 1.3;
    margin-bottom: 0.25rem;
    color: var(--color-text);
  }

  .exp-overlay-desc {
    font-size: 0.8125rem;
    line-height: 1.4;
    color: var(--color-text-sec);
  }

  .exp-info {
    transition: opacity var(--duration-hover) var(--ease-smooth);
  }

  .exp-title {
    font-family: var(--font-headline);
    font-weight: 700;
    font-size: clamp(1rem, 1.5vw, 1.125rem);
    line-height: 1.3;
    margin-bottom: var(--space-1);
  }
</style>
