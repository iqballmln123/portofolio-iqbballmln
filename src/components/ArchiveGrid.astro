---
import ChapterNumber from './ChapterNumber.astro';

interface ArchiveProject {
  title: string;
  desc: string;
  tools: string;
  images: { src: string; alt: string }[];
}

const projects: ArchiveProject[] = [
  {
    title: 'FreshEat',
    desc: 'Aplikasi food delivery mobile dengan fitur rekomendasi makanan, realtime map tracking, dan sistem promo/badge.',
    tools: 'Kotlin, Jetpack Compose',
    images: [
      { src: '/images/archive/fresheat.png', alt: 'Dashboard FreshEat' },
      { src: '/images/archive/fresheat-resto.png', alt: 'Pilih Restoran' },
      { src: '/images/archive/fresheat-fav.png', alt: 'Favorit' },
      { src: '/images/archive/fresheat-delivery.png', alt: 'Delivery' },
      { src: '/images/archive/fresheat-map.png', alt: 'Realtime Map' },
    ],
  },
  {
    title: 'VClean',
    desc: 'Aplikasi laundry/cleaning service mobile dengan dashboard pemesanan, chat, voucher, dan halaman favorit.',
    tools: 'Kotlin, Jetpack Compose',
    images: [
      { src: '/images/archive/vclean.png', alt: 'Dashboard VClean' },
      { src: '/images/archive/vclean-fav.png', alt: 'Favorit' },
      { src: '/images/archive/vclean-chat.png', alt: 'Chat' },
      { src: '/images/archive/vclean-order.png', alt: 'Order' },
      { src: '/images/archive/vclean-voucher.png', alt: 'Voucher' },
    ],
  },
  {
    title: 'PiggyBank',
    desc: 'Aplikasi tabungan sederhana dengan fitur login/register, dashboard saldo, dan CRUD data transaksi.',
    tools: 'Java, Android SDK',
    images: [
      { src: '/images/archive/piggybank.png', alt: 'Dashboard PiggyBank' },
      { src: '/images/archive/piggybank-login.png', alt: 'Login' },
      { src: '/images/archive/piggybank-edit.png', alt: 'Edit' },
      { src: '/images/archive/piggybank-delete.png', alt: 'Delete' },
    ],
  },
  {
    title: 'ToDo-List',
    desc: 'Web app task manager dengan autentikasi multi-akun, checklist interaktif, dan pengelolaan data per user.',
    tools: 'HTML, CSS, JavaScript, PHP',
    images: [
      { src: '/images/archive/todolist.jpg', alt: 'ToDo-List' },
      { src: '/images/archive/todolist-login.jpg', alt: 'Login' },
      { src: '/images/archive/todolist-check.jpg', alt: 'Check Data' },
      { src: '/images/archive/todolist-akun.jpg', alt: 'Multi Akun' },
    ],
  },
  {
    title: 'Last Life — FPS Zombie',
    desc: 'Game FPS zombie survival dibangun dengan Unity. First-person camera, pemilihan senjata, dan multiplayer lokal.',
    tools: 'Unity, C#',
    images: [
      { src: '/images/archive/lastlife.jpg', alt: 'Poster Last Life' },
      { src: '/images/archive/lastlife-weapon.png', alt: 'Pilih Senjata' },
      { src: '/images/archive/lastlife-gameplay.png', alt: 'Gameplay' },
      { src: '/images/archive/lastlife-hit.png', alt: 'Hit Zombie' },
    ],
  },
  {
    title: 'Driving Car',
    desc: 'Game simulasi mengemudi dengan third-person camera, dibangun dengan Unity.',
    tools: 'Unity, C#',
    images: [
      { src: '/images/archive/drivingcar.jpg', alt: 'Driving Car' },
    ],
  },
];
---

<section id="archive" class="section" style="background-color: var(--color-bg-alt);">
  <div class="grid-line grid-line--h" style="top: 0;" aria-hidden="true"></div>

  <div class="container">
    <div class="archive-header reveal">
      <ChapterNumber number="04" label="Archive" />
      <p class="text-secondary" style="margin-top: var(--space-2); max-width: 32rem;">
        Proyek-proyek lain yang menunjukkan keluasan kemampuan — klik untuk melihat detail.
      </p>
    </div>

    <div class="archive-list">
      {projects.map((project, idx) => (
        <details class="archive-item reveal" id={`archive-${idx}`}>
          <summary class="archive-summary">
            <div class="archive-summary-left">
              <div class="archive-preview-img">
                <img src={project.images[0].src} alt={project.images[0].alt} loading="lazy" />
              </div>
              <div class="archive-summary-text">
                <h3 class="archive-title">{project.title}</h3>
                <span class="text-mono-sm text-secondary">{project.tools}</span>
              </div>
            </div>
            <span class="archive-toggle" aria-hidden="true">+</span>
          </summary>

          <div class="archive-detail">
            <p class="archive-desc">{project.desc}</p>
            <div class="archive-screenshots">
              {project.images.map((img) => (
                <div class="archive-ss-item">
                  <img src={img.src} alt={img.alt} loading="lazy" />
                  <span class="img-caption">{img.alt}</span>
                </div>
              ))}
            </div>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .archive-header {
    margin-bottom: var(--space-8);
  }

  .archive-list {
    display: flex;
    flex-direction: column;
  }

  .archive-item {
    border-top: 1px solid var(--color-border);
  }

  .archive-item:last-child {
    border-bottom: 1px solid var(--color-border);
  }

  .archive-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-3) 0;
    cursor: pointer;
    list-style: none;
    user-select: none;
    transition: background-color var(--duration-hover) var(--ease-editorial);
  }

  .archive-summary::-webkit-details-marker {
    display: none;
  }

  .archive-summary:hover {
    background-color: var(--color-accent-light);
    padding-inline: var(--space-2);
    margin-inline: calc(var(--space-2) * -1);
    border-radius: 2px;
  }

  .archive-summary-left {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .archive-preview-img {
    width: 72px;
    height: 48px;
    overflow: hidden;
    border: 1px solid var(--color-border);
    background-color: #E8E4DC;
    flex-shrink: 0;
  }

  .archive-preview-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .archive-summary-text {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }

  .archive-title {
    font-family: var(--font-headline);
    font-weight: 700;
    font-size: clamp(1.125rem, 2vw, 1.375rem);
    line-height: 1.3;
    color: var(--color-text);
  }

  .archive-toggle {
    font-family: var(--font-mono);
    font-size: 1.25rem;
    color: var(--color-accent);
    flex-shrink: 0;
    transition: transform var(--duration-hover) var(--ease-out-expo);
    width: 1.5rem;
    text-align: center;
  }

  details[open] .archive-toggle {
    transform: rotate(45deg);
  }

  /* ── Expanded detail ── */
  .archive-detail {
    padding-bottom: var(--space-6);
    padding-top: var(--space-2);
  }

  .archive-desc {
    margin-bottom: var(--space-4);
    max-width: 36rem;
    color: var(--color-text);
  }

  .archive-screenshots {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: var(--space-2);
  }

  .archive-ss-item {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    overflow: hidden;
  }

  .archive-ss-item img {
    width: 100%;
    aspect-ratio: 9 / 16;
    object-fit: cover;
    object-position: top center;
    display: block;
  }

  .archive-ss-item .img-caption {
    padding: 0.375rem 0.5rem;
    border-top: 1px solid var(--color-border);
  }

  @media (min-width: 768px) {
    .archive-preview-img {
      width: 96px;
      height: 64px;
    }

    .archive-screenshots {
      grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
    }
  }
</style>
