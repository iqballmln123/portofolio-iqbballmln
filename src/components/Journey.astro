---
import ChapterNumber from './ChapterNumber.astro';

const milestones = [
  {
    year: '2023 - 2026',
    role: 'D3 Rekayasa Perangkat Lunak Aplikasi',
    company: 'Telkom University',
    desc: 'Membangun dasar rekayasa perangkat lunak dengan fokus pada integrasi sistem end-to-end. Berawal dari pengembangan aplikasi Android native (Kotlin, Jetpack Compose), kemudian berekspansi ke ranah hardware/embedded systems (IoT, ESP32, sensor pintar).',
  },
  {
    year: 'Feb - Jun 2026',
    role: 'Network & IoT Engineering Intern',
    company: 'Telkomsel',
    desc: 'Berperan di Divisi Network Operations. Merancang dan mengembangkan alat automasi pelaporan coverage jaringan seluler menggunakan Python dan Streamlit. Tools ini diserahterimakan dan secara aktif mempercepat alur kerja harian tim operasional lapangan.',
  },
  {
    year: 'Present & Future',
    role: 'Menuju Industrial & Mining Automation',
    company: 'Next Step',
    desc: 'Mengarahkan fokus pada skala enterprise yang lebih masif. Mempelajari dan mengeksplorasi infrastruktur otomasi industri kelas berat seperti TIA Portal, PLC, dan SCADA, untuk menjembatani inovasi software modern ke dalam sektor industri.',
  },
];

const pillars = [
  {
    number: '01',
    title: 'Mobile App Engineering',
    tags: 'Kotlin · Jetpack Compose · Architecture',
    desc: 'Pengembangan aplikasi Android native berkinerja tinggi dengan UI deklaratif, alur reaktif, dan arsitektur scalable.',
  },
  {
    number: '02',
    title: 'IoT & Embedded Systems',
    tags: 'ESP32 · Sensors · Firebase · GSM',
    desc: 'Integrasi hardware multi-sensor (tanah, air, pH, TDS, kelistrikan) ke cloud dan aplikasi mobile secara real-time.',
  },
  {
    number: '03',
    title: 'Network & Automation',
    tags: 'Python · Streamlit · Telkomsel Ops',
    desc: 'Automasi alur kerja pelaporan enterprise yang mempercepat pengolahan data lapangan untuk tim Network Operations.',
  },
];
---

<section id="journey" class="section border-top">
  <div class="container">
    <div class="reveal journey-header">
      <ChapterNumber number="02" label="About & Journey" />
    </div>

    <!-- Editorial Bio Intro Block -->
    <div class="about-hero-block reveal">
      <blockquote class="about-pull-quote">
        "Lulusan D3 Rekayasa Perangkat Lunak Aplikasi dari Telkom University dengan latar belakang mobile development, IoT engineering, dan jaringan telekomunikasi."
      </blockquote>
      <p class="about-narrative text-secondary">
        Memulai dari pengembangan aplikasi Android dengan Kotlin dan Jetpack Compose, lalu memperluas ke sistem IoT berbasis ESP32 dan Firebase. Pada awal 2026 menyelesaikan internship di Divisi Network & IoT Telkomsel, membangun automasi pelaporan coverage jaringan yang dipakai langsung oleh tim Network Operations. Saat ini mengarahkan langkah berikutnya ke sektor industrial dan mining IoT.
      </p>
    </div>

    <!-- Asymmetric Grid: Pillars & Timeline -->
    <div class="journey-grid">
      <!-- Left Column: Core Focus Pillars -->
      <div class="journey-left reveal">
        <h3 class="section-sublabel text-mono-sm text-secondary">CORE ENGINEERING PILLARS</h3>
        <div class="pillars-list">
          {pillars.map((pillar) => (
            <div class="pillar-card">
              <div class="pillar-header">
                <span class="pillar-num">{pillar.number}</span>
                <span class="pillar-tags text-mono-sm text-secondary">{pillar.tags}</span>
              </div>
              <h4 class="pillar-title">{pillar.title}</h4>
              <p class="pillar-desc text-secondary">{pillar.desc}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- Right Column: Career Timeline -->
      <div class="journey-right">
        <h3 class="section-sublabel text-mono-sm text-secondary reveal">CAREER MILESTONES</h3>
        <div class="timeline-container reveal">
          <!-- Track (Background Line) -->
          <div class="timeline-track"></div>
          
          <!-- The Progress Line -->
          <div class="timeline-glow" id="timeline-glow"></div>

          <div class="timeline-items">
            {milestones.map((item, i) => (
              <div class="timeline-item" data-index={i}>
                <div class="timeline-dot-wrapper">
                  <div class="timeline-dot"></div>
                  <div class="timeline-dot-glow"></div>
                </div>
                
                <div class="timeline-content">
                  <span class="timeline-year text-mono-sm">{item.year}</span>
                  <h4 class="timeline-role">{item.role}</h4>
                  <span class="timeline-company">{item.company}</span>
                  <p class="timeline-desc text-secondary">{item.desc}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .journey-header {
    margin-bottom: var(--space-4);
  }

  /* ── Editorial Bio Hero Block ── */
  .about-hero-block {
    margin-bottom: var(--space-12);
    padding-bottom: var(--space-8);
    border-bottom: 0.5px solid var(--color-border);
  }

  .about-pull-quote {
    font-family: var(--font-headline);
    font-style: italic;
    font-weight: 700;
    font-size: clamp(1.375rem, 3vw, 2.25rem);
    line-height: 1.35;
    color: var(--color-text);
    margin-bottom: var(--space-4);
    max-width: 54rem;
    position: relative;
    padding-left: var(--space-6);
  }

  .about-pull-quote::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.25rem;
    bottom: 0.25rem;
    width: 3px;
    background-color: var(--color-accent);
  }

  .about-narrative {
    font-family: var(--font-body);
    font-size: clamp(1rem, 1.25vw, 1.125rem);
    line-height: var(--lh-body);
    max-width: 52rem;
  }

  /* ── Asymmetric Layout Grid ── */
  .journey-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-12);
  }

  @media (min-width: 992px) {
    .journey-grid {
      grid-template-columns: 1fr 1.1fr;
      gap: var(--space-12);
      align-items: start;
    }
  }

  .section-sublabel {
    letter-spacing: var(--ls-wide);
    margin-bottom: var(--space-6);
    display: block;
    text-transform: uppercase;
  }

  /* ── Pillars List ── */
  .pillars-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .pillar-card {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    padding: var(--space-5);
    border-radius: 2px;
    transition: transform var(--duration-hover) var(--ease-editorial),
                border-color var(--duration-hover) var(--ease-editorial),
                box-shadow var(--duration-hover) var(--ease-editorial);
  }

  .pillar-card:hover {
    border-color: var(--color-accent);
    transform: translateY(-2px);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.04);
  }

  .pillar-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-2);
  }

  .pillar-num {
    font-family: var(--font-mono);
    font-size: var(--text-meta);
    letter-spacing: var(--ls-wide);
    color: var(--color-accent);
    font-weight: 700;
  }

  .pillar-tags {
    font-size: 0.75rem;
  }

  .pillar-title {
    font-family: var(--font-headline);
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.25;
    color: var(--color-text);
    margin-bottom: var(--space-2);
  }

  .pillar-desc {
    font-size: 0.9375rem;
    line-height: 1.55;
  }

  /* ── Timeline Styles ── */
  .timeline-container {
    position: relative;
    padding-left: 28px;
    width: 100%;
  }

  @media (min-width: 768px) {
    .timeline-container {
      padding-left: 32px;
    }
  }

  .timeline-track {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 2px;
    background-color: var(--color-border);
  }

  .timeline-glow {
    position: absolute;
    left: 0;
    top: 0;
    width: 2px;
    height: 0%;
    background-color: var(--color-accent);
    z-index: 1;
  }

  .timeline-items {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .timeline-item {
    position: relative;
  }

  .timeline-dot-wrapper {
    position: absolute;
    left: -28px;
    top: 18px;
    transform: translateX(-50%);
    z-index: 2;
  }

  @media (min-width: 768px) {
    .timeline-dot-wrapper {
      left: -32px;
    }
  }

  .timeline-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background-color: var(--color-bg);
    border: 2px solid var(--color-border);
    transition: all 0.3s ease;
  }

  .timeline-dot-glow {
    position: absolute;
    inset: -4px;
    border-radius: 50%;
    background-color: var(--color-accent);
    opacity: 0;
    transform: scale(0);
    transition: all 0.3s ease;
    z-index: -1;
  }

  .timeline-content {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    padding: var(--space-4) var(--space-5);
    border-radius: 2px;
    transition: transform 0.3s ease, opacity 0.3s ease, border-color 0.3s ease;
    opacity: 0.6;
    position: relative;
  }

  .timeline-content::before {
    content: '';
    position: absolute;
    left: -5px;
    top: 18px;
    width: 8px;
    height: 8px;
    background-color: var(--color-surface);
    border-left: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    transform: rotate(45deg);
    transition: border-color 0.3s ease;
  }

  .timeline-year {
    display: inline-block;
    padding: 0.125rem 0.5rem;
    border: 1px solid var(--color-border);
    border-radius: 100px;
    color: var(--color-text-sec);
    margin-bottom: var(--space-2);
    font-size: 0.75rem;
  }

  .timeline-role {
    font-family: var(--font-headline);
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: 0.125rem;
    line-height: 1.25;
  }

  .timeline-company {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--color-text-sec);
    margin-bottom: var(--space-3);
  }

  .timeline-desc {
    line-height: 1.55;
    font-size: 0.875rem;
  }

  /* Active State */
  .timeline-item.is-active .timeline-dot {
    background-color: var(--color-accent);
    border-color: var(--color-accent);
  }

  .timeline-item.is-active .timeline-dot-glow {
    opacity: 0.3;
    transform: scale(1);
  }

  .timeline-item.is-active .timeline-content {
    opacity: 1;
    border-color: var(--color-accent);
  }

  .timeline-item.is-active .timeline-content::before {
    border-color: var(--color-accent);
  }

  .timeline-item.is-active .timeline-year {
    color: var(--color-accent);
    border-color: rgba(29, 158, 117, 0.3);
    background-color: rgba(29, 158, 117, 0.05);
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  document.addEventListener('DOMContentLoaded', initTimeline);

  function initTimeline() {
    gsap.registerPlugin(ScrollTrigger);

    const glow = document.getElementById('timeline-glow');
    if (glow) {
      gsap.to(glow, {
        height: '100%',
        ease: 'none',
        scrollTrigger: {
          trigger: '.timeline-container',
          start: 'top 65%',
          end: 'bottom 65%',
          scrub: true,
        },
      });
    }

    const items = document.querySelectorAll('.timeline-item');
    items.forEach((item) => {
      ScrollTrigger.create({
        trigger: item,
        start: 'top 65%',
        toggleClass: { targets: item, className: 'is-active' },
      });
    });
  }
</script>
