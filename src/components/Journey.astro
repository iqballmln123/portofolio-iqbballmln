---
import ChapterNumber from './ChapterNumber.astro';

const milestones = [
  {
    year: '2023 - 2026',
    role: 'D3 Rekayasa Perangkat Lunak Aplikasi',
    company: 'Telkom University',
    desc: 'Membangun dasar rekayasa perangkat lunak dengan fokus pada integrasi sistem end-to-end. Berawal dari pengembangan aplikasi Android native (Kotlin, Jetpack Compose), kemudian berekspansi ke ranah hardware/embedded systems (IoT, ESP32, sensor pintar).',
  },
  {
    year: 'Feb - Jun 2026',
    role: 'Network & IoT Engineering Intern',
    company: 'Telkomsel',
    desc: 'Berperan di Divisi Network Operations. Merancang dan mengembangkan alat automasi pelaporan coverage jaringan seluler menggunakan Python dan Streamlit. Tools ini diserahterimakan dan secara aktif mempercepat alur kerja harian tim operasional lapangan.',
  },
  {
    year: 'Present & Future',
    role: 'Menuju Industrial & Mining Automation',
    company: 'Next Step',
    desc: 'Mengarahkan fokus pada skala enterprise yang lebih masif. Mempelajari dan mengeksplorasi infrastruktur otomasi industri kelas berat seperti TIA Portal, PLC, dan SCADA, untuk menjembatani inovasi software modern ke dalam sektor industri.',
  },
];
---

<section id="journey" class="section border-top">
  <div class="container">
    <div class="reveal">
      <ChapterNumber number="02" label="Journey / Timeline" />
    </div>

    <div class="journey-grid">
      <!-- Left Column: Timeline -->
      <div class="journey-left">
        <div class="timeline-container reveal">
          <!-- Track (Background Line) -->
          <div class="timeline-track"></div>
          
          <!-- The Glowing Progress Line -->
          <div class="timeline-glow" id="timeline-glow"></div>

          <div class="timeline-items">
            {milestones.map((item, i) => (
              <div class="timeline-item" data-index={i}>
                <div class="timeline-dot-wrapper">
                  <div class="timeline-dot"></div>
                  <div class="timeline-dot-glow"></div>
                </div>
                
                <div class="timeline-content">
                  <span class="timeline-year text-mono-sm">{item.year}</span>
                  <h3 class="timeline-role">{item.role}</h3>
                  <span class="timeline-company">{item.company}</span>
                  <p class="timeline-desc text-secondary">{item.desc}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>

      <!-- Right Column: 3D Model -->
      <div class="journey-right">
        <div class="model-container">
          <!-- 3D Three.js Interactive Plane -->
          <div id="threejs-container" class="threejs-box">
            <!-- Canvas will be injected here by Three.js -->
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .journey-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-12);
    margin-top: var(--space-12);
  }

  @media (min-width: 1024px) {
    .journey-grid {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-16);
      align-items: center;
    }
  }

  .timeline-container {
    position: relative;
    padding-left: 24px;
    width: 100%;
  }

  /* 3D Model Container Styles */
  .model-container {
    width: 100%;
    height: 500px;
    position: relative;
    perspective: 1000px;
  }

  /* 3D Three.js Container Styles */
  .threejs-box {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: grab;
  }
  
  .threejs-box:active {
    cursor: grabbing;
  }
  
  .threejs-box canvas {
    border-radius: 8px;
    box-shadow: 0 20px 40px rgba(0,0,0,0.3);
    outline: none;
  }

  .model-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px dashed var(--color-border);
    border-radius: 4px;
  }

  @media (min-width: 768px) {
    .timeline-container {
      padding-left: 32px;
    }
  }

  /* The background line */
  .timeline-track {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 2px;
    background-color: var(--color-border);
  }

  /* The glowing line that fills up */
  .timeline-glow {
    position: absolute;
    left: 0;
    top: 0;
    width: 2px;
    height: 0%; /* controlled by GSAP */
    background-color: var(--color-accent);
    box-shadow: 0 0 10px var(--color-accent), 0 0 20px var(--color-accent);
    z-index: 1;
  }

  .timeline-items {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
  }

  .timeline-item {
    position: relative;
  }

  /* The Dot */
  .timeline-dot-wrapper {
    position: absolute;
    left: -24px; /* match container padding */
    top: 6px;
    transform: translateX(-50%);
    z-index: 2;
  }

  @media (min-width: 768px) {
    .timeline-dot-wrapper {
      left: -32px;
    }
  }

  .timeline-dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background-color: var(--color-bg);
    border: 2px solid var(--color-border);
    transition: all 0.4s ease;
  }

  .timeline-dot-glow {
    position: absolute;
    inset: -6px;
    border-radius: 50%;
    background-color: var(--color-accent);
    opacity: 0;
    transform: scale(0);
    transition: all 0.4s ease;
    filter: blur(4px);
    z-index: -1;
  }

  /* Content */
  .timeline-content {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    padding: var(--space-5);
    border-radius: 2px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.02);
    transition: transform 0.4s ease, opacity 0.4s ease, border-color 0.4s ease, box-shadow 0.4s ease;
    opacity: 0.5; /* dim until active */
    transform: translateX(0);
    position: relative;
  }
  
  /* Little arrow pointing to the timeline */
  .timeline-content::before {
    content: '';
    position: absolute;
    left: -5px;
    top: 24px;
    width: 8px;
    height: 8px;
    background-color: var(--color-surface);
    border-left: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    transform: rotate(45deg);
    transition: border-color 0.4s ease;
  }

  .timeline-year {
    display: inline-block;
    padding: 0.125rem 0.5rem;
    border: 1px solid var(--color-border);
    border-radius: 100px;
    color: var(--color-text-sec);
    margin-bottom: var(--space-3);
    transition: all 0.4s ease;
  }

  .timeline-role {
    font-family: var(--font-headline);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: var(--space-1);
    line-height: 1.2;
  }

  .timeline-company {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--color-text-sec);
    margin-bottom: var(--space-4);
    transition: color 0.4s ease;
  }

  .timeline-desc {
    line-height: 1.6;
    font-size: 1rem;
  }

  /* ── ACTIVE STATE (triggered by GSAP ScrollTrigger) ── */
  
  .timeline-item.is-active .timeline-dot {
    background-color: var(--color-accent);
    border-color: var(--color-accent);
  }

  .timeline-item.is-active .timeline-dot-glow {
    opacity: 0.5;
    transform: scale(1);
  }

  .timeline-item.is-active .timeline-content {
    opacity: 1;
    transform: translateX(8px);
    border-color: var(--color-accent);
    box-shadow: 0 10px 40px rgba(23, 141, 104, 0.05);
  }

  .timeline-item.is-active .timeline-content::before {
    border-color: var(--color-accent);
  }

  .timeline-item.is-active .timeline-year {
    color: var(--color-accent);
    border-color: rgba(23, 141, 104, 0.3);
    background-color: rgba(23, 141, 104, 0.05);
  }

  .timeline-item.is-active .timeline-company {
    color: var(--color-text);
  }
</style>

<script>
  import * as THREE from 'three';
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  // Three.js Setup
  function initThreeJS() {
    const container = document.getElementById('threejs-container');
    if (!container) return;

    // Bersihkan canvas lama jika ada (penting untuk Astro page transitions)
    container.innerHTML = '';

    const width = container.clientWidth || 400;
    const height = container.clientHeight || 500;

    const scene = new THREE.Scene();
    
    // Kamera
    const camera = new THREE.PerspectiveCamera(45, width / height, 0.1, 1000);
    camera.position.z = 5;

    // Renderer
    const renderer = new THREE.WebGLRenderer({ alpha: true, antialias: true });
    renderer.setSize(width, height);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    container.appendChild(renderer.domElement);

    // Lighting untuk efek 3D realistis
    const ambientLight = new THREE.AmbientLight(0xffffff, 1.2);
    scene.add(ambientLight);

    const dirLight = new THREE.DirectionalLight(0xffffff, 2.2);
    dirLight.position.set(5, 5, 6);
    scene.add(dirLight);

    const rimLight = new THREE.DirectionalLight(0x178d68, 1.0); // Sentuhan warna aksen
    rimLight.position.set(-5, -3, -4);
    scene.add(rimLight);

    // Geometry & Texture untuk Kotak 3D (BoxGeometry)
    // Width: 2.6, Height: 3.6, Depth: 0.45 (Memiliki ketebalan nyata)
    const geometry = new THREE.BoxGeometry(2.6, 3.6, 0.45);

    const textureLoader = new THREE.TextureLoader();
    const texture = textureLoader.load('/images/super-iot-man-box.png', (loadedTex) => {
      loadedTex.colorSpace = THREE.SRGBColorSpace;
      const imgAspect = loadedTex.image.width / loadedTex.image.height;
      const baseHeight = 3.6;
      const calcWidth = baseHeight * imgAspect;
      // Perbarui dimensi kotak agar persis sesuai rasio aspek gambar PNG
      boxMesh.scale.set(calcWidth / 2.6, 1, 1);
    });

    // Material Samping/Belakang: Plastik Hitam/Abu-abu gelap yang elegan
    const sideMaterial = new THREE.MeshStandardMaterial({ 
      color: 0x141416, 
      roughness: 0.25, 
      metalness: 0.3 
    });

    // Material Depan: Gambar PNG Kotak Mainan
    const frontMaterial = new THREE.MeshStandardMaterial({ 
      map: texture,
      transparent: true,
      roughness: 0.3,
      metalness: 0.1
    });

    // Urutan sisi BoxGeometry Three.js: [Right, Left, Top, Bottom, Front, Back]
    const materials = [
      sideMaterial,
      sideMaterial,
      sideMaterial,
      sideMaterial,
      frontMaterial,
      sideMaterial
    ];

    const boxMesh = new THREE.Mesh(geometry, materials);
    scene.add(boxMesh);

    // Mouse & Touch Tracking untuk rotasi 3D interaktif
    let mouseX = 0;
    let mouseY = 0;
    let targetX = 0;
    let targetY = 0;
    const windowHalfX = width / 2;
    const windowHalfY = height / 2;

    container.addEventListener('mousemove', (event) => {
      const rect = container.getBoundingClientRect();
      const x = event.clientX - rect.left;
      const y = event.clientY - rect.top;
      
      // Jangkauan rotasi yang lebih terasa (hingga 45 derajat) agar ketebalan 3D terlihat
      mouseX = ((x - windowHalfX) / windowHalfX) * 0.8;
      mouseY = ((y - windowHalfY) / windowHalfY) * 0.6;
    });

    container.addEventListener('mouseleave', () => {
      mouseX = 0;
      mouseY = 0;
    });

    // Responsif ketika layar diubah ukurannya
    window.addEventListener('resize', () => {
      const newWidth = container.clientWidth || 400;
      const newHeight = container.clientHeight || 500;
      camera.aspect = newWidth / newHeight;
      camera.updateProjectionMatrix();
      renderer.setSize(newWidth, newHeight);
    });

    // Animation Loop dengan efek animasi idle melayang (Floating Animation)
    let clock = new THREE.Clock();

    function animate() {
      requestAnimationFrame(animate);

      const elapsedTime = clock.getElapsedTime();

      // Target rotasi dari gerakan mouse
      targetX = mouseX;
      targetY = mouseY;

      // Lerp (smooth interpolation)
      boxMesh.rotation.y += 0.05 * (targetX - boxMesh.rotation.y);
      boxMesh.rotation.x += 0.05 * (targetY - boxMesh.rotation.x);

      // Animasi melayang meliuk halus (Sine Wave Float)
      boxMesh.position.y = Math.sin(elapsedTime * 1.5) * 0.08;

      renderer.render(scene, camera);
    }
    
    animate();
  }

  // Initialize immediately
  document.addEventListener('DOMContentLoaded', () => {
    initThreeJS();
  });

  // Ensure this runs after Astro page transitions and DOM loads
  document.addEventListener('DOMContentLoaded', initTimeline);
  
  // Optional: If you use ViewTransitions in Astro, use astro:page-load
  // document.addEventListener('astro:page-load', initTimeline);

  function initTimeline() {
    gsap.registerPlugin(ScrollTrigger);

    // 1. Line Glow Animation
    const glow = document.getElementById('timeline-glow');
    if (glow) {
      gsap.to(glow, {
        height: '100%',
        ease: 'none',
        scrollTrigger: {
          trigger: '.timeline-container',
          start: 'top 60%', // Starts filling when top of container hits 60% of viewport
          end: 'bottom 60%',
          scrub: true,
        }
      });
    }

    // 2. Active State Toggle for Items
    const items = document.querySelectorAll('.timeline-item');
    items.forEach((item) => {
      ScrollTrigger.create({
        trigger: item,
        start: 'top 60%', // Trigger when item reaches 60% of viewport
        toggleClass: { targets: item, className: 'is-active' },
        // if you want it to stay active once reached, remove toggleActions or leave default
      });
    });
  }
</script>
