---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ChapterNumber from '../../components/ChapterNumber.astro';
import { featuredProjects, type ProjectData } from '../../data/projectsData';

export function getStaticPaths() {
  return featuredProjects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

interface Props {
  project: ProjectData;
}

const { project } = Astro.props;
const toolsList = project.tools.split(',').map((t) => t.trim());

// Find index for next project link
const currentIndex = featuredProjects.findIndex((p) => p.slug === project.slug);
const nextProject = featuredProjects[(currentIndex + 1) % featuredProjects.length];
---

<BaseLayout title={`${project.title} — Case Study`} description={project.tagline}>
  <main class="project-detail-main">
    
    <!-- Sticky Top Bar with Back Button -->
    <div class="top-nav-bar">
      <div class="container">
        <a href="/#projects" class="back-btn text-mono-sm">
          <span class="back-arrow">←</span> Kembali ke Portofolio
        </a>
      </div>
    </div>

    <!-- Case Study Detail Container -->
    <section class="section project-hero-section">
      <div class="container">
        
        <!-- Header -->
        <div class="project-detail-header reveal">
          <ChapterNumber number={project.chapter} label="Case Study Showcase" />
          <h1 class="headline headline--hero project-detail-title">{project.title}</h1>
          <p class="project-detail-tagline text-secondary">{project.tagline}</p>
          
          <div class="project-detail-tools">
            {toolsList.map((tool) => (
              <span class="tool-tag text-mono-sm">{tool}</span>
            ))}
          </div>
        </div>

        <!-- Premium macOS / Device Framing Photo Showcase Gallery (Embla) -->
        <div class="project-detail-gallery reveal">
          <project-gallery>
            <div class="device-window-frame">
              <!-- Window Header Bar (macOS Style) -->
              <div class="window-header-bar">
                <div class="window-dots">
                  <span class="dot dot--red"></span>
                  <span class="dot dot--yellow"></span>
                  <span class="dot dot--green"></span>
                </div>
                <div class="window-url text-mono-sm">
                  <span>iqbal.dev/case-study/{project.slug}</span>
                </div>
                <div class="window-counter text-mono-sm" data-indicator>
                  01 / {String(project.images.length).padStart(2, '0')}
                </div>
              </div>

              <!-- Main Viewport -->
              <div class="embla__viewport" data-embla-viewport>
                <div class="embla__container">
                  {project.images.map((img, idx) => (
                    <div class="embla__slide">
                      <div class="slide-inner">
                        <div class="image-stage">
                          <img src={img.src} alt={img.alt} loading={idx === 0 ? "eager" : "lazy"} class="showcase-img" />
                        </div>
                      </div>
                      <div class="slide-caption-bar">
                        <span class="caption-num text-mono-sm">FIG {(idx + 1).toString().padStart(2, '0')}</span>
                        <span class="img-caption text-mono-sm">{img.alt}</span>
                      </div>
                    </div>
                  ))}
                </div>
              </div>

              <!-- Interactive Controls & Navigation Toolbar -->
              <div class="window-toolbar">
                <button class="nav-btn" data-prev aria-label="Previous screenshot">
                  <span class="btn-icon">←</span> <span class="btn-text text-mono-sm">PREV</span>
                </button>

                <!-- Thumbnails Strip -->
                <div class="thumbnails-strip" data-thumbnails>
                  {project.images.map((img, idx) => (
                    <button class="thumb-btn" data-thumb-index={idx} aria-label={`Jump to slide ${idx + 1}`}>
                      <img src={img.src} alt={img.alt} />
                    </button>
                  ))}
                </div>

                <button class="nav-btn" data-next aria-label="Next screenshot">
                  <span class="btn-text text-mono-sm">NEXT</span> <span class="btn-icon">→</span>
                </button>
              </div>
            </div>
          </project-gallery>
        </div>

        <!-- Case Study Narrative Breakdown -->
        <div class="case-study-narrative reveal">
          <div class="narrative-block">
            <h2 class="narrative-label text-mono-sm">01 / MASALAH</h2>
            <p class="narrative-text">{project.problem}</p>
          </div>

          <div class="narrative-block">
            <h2 class="narrative-label text-mono-sm">02 / PROSES & IMPLEMENTASI</h2>
            <p class="narrative-text">{project.process}</p>
          </div>

          <div class="narrative-block">
            <h2 class="narrative-label text-mono-sm">03 / HASIL & IMPACT</h2>
            <p class="narrative-text">{project.result}</p>
          </div>
        </div>

        <!-- Next Project Footer Link -->
        <div class="next-project-footer reveal">
          <span class="text-mono-sm text-secondary">NEXT CASE STUDY</span>
          <a href={`/projects/${nextProject.slug}`} class="next-project-link">
            <span class="next-title">{nextProject.title}</span>
            <span class="next-arrow">→</span>
          </a>
        </div>

      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .project-detail-main {
    min-height: 100vh;
    padding-top: var(--space-8);
  }

  .top-nav-bar {
    position: sticky;
    top: 1.5rem;
    z-index: 100;
    margin-bottom: var(--space-6);
  }

  .back-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(var(--color-surface-rgb), 0.7);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    padding: 0.5rem 1rem;
    border-radius: 100px;
    color: var(--color-text);
    text-decoration: none;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .back-btn:hover {
    background: var(--color-text);
    color: var(--color-bg);
  }

  .project-detail-header {
    margin-bottom: var(--space-10);
    max-width: 56rem;
  }

  .project-detail-title {
    font-size: clamp(2rem, 5vw, 3.5rem);
    line-height: 1.1;
    margin-top: var(--space-2);
    margin-bottom: var(--space-4);
  }

  .device-window-frame {
    background: rgba(var(--color-surface-rgb), 0.5);
    backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
  }

  .window-header-bar {
    background: rgba(var(--color-bg-rgb), 0.8);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    padding: 0.75rem 1.25rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .window-url {
    background: rgba(0, 0, 0, 0.05);
    padding: 0.2rem 1rem;
    border-radius: 100px;
    color: var(--color-text-sec);
  }

  .slide-inner {
    height: 480px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-6);
  }

  .narrative-block {
    background: rgba(var(--color-surface-rgb), 0.4);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    padding: var(--space-6);
    border-radius: 12px;
  }

  .next-project-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    text-decoration: none;
    color: var(--color-text);
    padding: var(--space-4) 0;
    transition: transform 0.3s ease;
  }

  .next-project-link:hover {
    transform: translateX(10px);
  }

  .next-arrow {
    font-size: 1.75rem;
    transition: transform 0.3s ease;
  }

  .next-project-link:hover .next-arrow {
    transform: translateX(6px);
  }
</style>

<script type="module">
  import EmblaCarousel from 'embla-carousel';
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  class ProjectGallery extends HTMLElement {
    connectedCallback() {
      const viewportNode = this.querySelector('[data-embla-viewport]') as HTMLElement;
      if (!viewportNode) return;

      const emblaApi = EmblaCarousel(viewportNode, { loop: true });
      
      const prevBtn = this.querySelector('[data-prev]');
      const nextBtn = this.querySelector('[data-next]');
      const indicator = this.querySelector('[data-indicator]');
      const thumbBtns = this.querySelectorAll<HTMLButtonElement>('[data-thumb-index]');
      
      if (prevBtn) prevBtn.addEventListener('click', () => emblaApi.scrollPrev());
      if (nextBtn) nextBtn.addEventListener('click', () => emblaApi.scrollNext());

      thumbBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          const index = parseInt(btn.dataset.thumbIndex || '0', 10);
          emblaApi.scrollTo(index);
        });
      });
      
      const updateIndicator = () => {
        const selected = emblaApi.selectedScrollSnap();
        const total = emblaApi.scrollSnapList().length;

        if (indicator) {
          indicator.textContent = `${String(selected + 1).padStart(2, '0')} / ${String(total).padStart(2, '0')}`;
        }

        thumbBtns.forEach((btn, idx) => {
          if (idx === selected) {
            btn.classList.add('is-active');
          } else {
            btn.classList.remove('is-active');
          }
        });
      };
      
      emblaApi.on('select', updateIndicator);
      emblaApi.on('reInit', updateIndicator);
      updateIndicator();
    }
  }

  if (!customElements.get('project-gallery')) {
    customElements.define('project-gallery', ProjectGallery);
  }

  // GSAP reveal animations for elements with .reveal class
  gsap.utils.toArray('.reveal').forEach((el) => {
    gsap.from(el, {
      opacity: 0,
      y: 30,
      duration: 0.8,
      ease: 'power2.out',
      scrollTrigger: {
        trigger: el,
        start: 'top 85%',
      },
    });
  });
</script>
