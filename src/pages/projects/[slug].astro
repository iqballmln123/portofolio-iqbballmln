---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ChapterNumber from '../../components/ChapterNumber.astro';
import { featuredProjects, type ProjectData } from '../../data/projectsData';

export function getStaticPaths() {
  return featuredProjects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

interface Props {
  project: ProjectData;
}

const { project } = Astro.props;
const toolsList = project.tools.split(',').map((t) => t.trim());

// Find index for next project link
const currentIndex = featuredProjects.findIndex((p) => p.slug === project.slug);
const nextProject = featuredProjects[(currentIndex + 1) % featuredProjects.length];
---

<BaseLayout title={`${project.title} — Case Study`} description={project.tagline}>
  <main class="project-detail-main">
    
    <!-- Sticky Top Bar with Back Button -->
    <div class="top-nav-bar">
      <div class="container">
        <a href="/#projects" class="back-btn text-mono-sm">
          <span class="back-arrow">←</span> Kembali ke Portofolio
        </a>
      </div>
    </div>

    <!-- Case Study Detail Container -->
    <section class="section project-hero-section">
      <div class="container">
        
        <!-- Header -->
        <div class="project-detail-header reveal">
          <ChapterNumber number={project.chapter} label="Case Study" />
          <h1 class="headline headline--hero project-detail-title">{project.title}</h1>
          <p class="project-detail-tagline text-secondary">{project.tagline}</p>
          
          <div class="project-detail-tools">
            {toolsList.map((tool) => (
              <span class="tool-tag text-mono-sm">{tool}</span>
            ))}
          </div>
        </div>

        <!-- Full Gallery Carousel (Embla) -->
        <div class="project-detail-gallery reveal">
          <project-gallery>
            <div class="gallery-container">
              <div class="embla__viewport" data-embla-viewport>
                <div class="embla__container">
                  {project.images.map((img, idx) => (
                    <div class="embla__slide">
                      <div class="slide-inner">
                        <img src={img.src} alt={img.alt} loading={idx === 0 ? "eager" : "lazy"} />
                      </div>
                      <span class="img-caption text-mono-sm">{img.alt}</span>
                    </div>
                  ))}
                </div>
              </div>
              
              {project.images.length > 1 && (
                <div class="gallery-controls">
                  <div class="gallery-indicator text-mono-sm" data-indicator>
                    1 / {project.images.length}
                  </div>
                  <div class="gallery-nav">
                    <button class="nav-btn" data-prev aria-label="Previous image">←</button>
                    <button class="nav-btn" data-next aria-label="Next image">→</button>
                  </div>
                </div>
              )}
            </div>
          </project-gallery>
        </div>

        <!-- Case Study Narrative Breakdown -->
        <div class="case-study-narrative reveal">
          <div class="narrative-block">
            <h2 class="narrative-label text-mono-sm">01 / MASALAH</h2>
            <p class="narrative-text">{project.problem}</p>
          </div>

          <div class="narrative-block">
            <h2 class="narrative-label text-mono-sm">02 / PROSES & IMPLEMENTASI</h2>
            <p class="narrative-text">{project.process}</p>
          </div>

          <div class="narrative-block">
            <h2 class="narrative-label text-mono-sm">03 / HASIL & IMPACT</h2>
            <p class="narrative-text">{project.result}</p>
          </div>
        </div>

        <!-- Next Project Footer Link -->
        <div class="next-project-footer reveal">
          <span class="text-mono-sm text-secondary">NEXT CASE STUDY</span>
          <a href={`/projects/${nextProject.slug}`} class="next-project-link">
            <span class="next-title">{nextProject.title}</span>
            <span class="next-arrow">→</span>
          </a>
        </div>

      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .project-detail-main {
    min-height: 100vh;
    padding-top: var(--space-8);
  }

  /* ── Top Bar with Back Button ── */
  .top-nav-bar {
    position: sticky;
    top: 1.5rem;
    z-index: 100;
    margin-bottom: var(--space-6);
  }

  .back-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    padding: 0.5rem 1rem;
    border-radius: 100px;
    color: var(--color-text);
    text-decoration: none;
    transition: all 0.3s var(--ease-editorial);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.04);
  }

  .back-btn:hover {
    background-color: var(--color-text);
    color: var(--color-bg);
    border-color: var(--color-text);
  }

  .back-arrow {
    transition: transform 0.3s ease;
  }

  .back-btn:hover .back-arrow {
    transform: translateX(-3px);
  }

  /* ── Header ── */
  .project-detail-header {
    margin-bottom: var(--space-10);
    max-width: 56rem;
  }

  .project-detail-title {
    font-size: clamp(2rem, 5vw, 3.5rem);
    line-height: 1.1;
    margin-top: var(--space-2);
    margin-bottom: var(--space-4);
  }

  .project-detail-tagline {
    font-size: clamp(1.125rem, 2vw, 1.375rem);
    line-height: 1.6;
    margin-bottom: var(--space-6);
  }

  .project-detail-tools {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tool-tag {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    padding: 0.25rem 0.75rem;
    border-radius: 100px;
    color: var(--color-text);
  }

  /* ── Gallery ── */
  .project-detail-gallery {
    margin-bottom: var(--space-12);
  }

  .gallery-container {
    border: 1px solid var(--color-border);
    background-color: var(--color-surface);
    border-radius: 4px;
    overflow: hidden;
  }

  .embla__viewport {
    overflow: hidden;
  }

  .embla__container {
    display: flex;
  }

  .embla__slide {
    flex: 0 0 100%;
    min-width: 0;
    display: flex;
    flex-direction: column;
  }

  .slide-inner {
    height: 480px;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: var(--color-bg-alt);
    padding: var(--space-4);
  }

  @media (min-width: 768px) {
    .slide-inner {
      height: 560px;
    }
  }

  .slide-inner img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }

  .img-caption {
    padding: 0.5rem 1rem;
    background-color: var(--color-surface);
    border-top: 1px solid var(--color-border);
    color: var(--color-text-sec);
    text-align: center;
  }

  .gallery-controls {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--space-3) var(--space-4);
    border-top: 1px solid var(--color-border);
    background-color: var(--color-surface);
  }

  .gallery-nav {
    display: flex;
    gap: 0.5rem;
  }

  .nav-btn {
    background: none;
    border: 1px solid var(--color-border);
    cursor: pointer;
    padding: 0.375rem 0.875rem;
    color: var(--color-text);
    border-radius: 4px;
    font-family: var(--font-mono);
    transition: all 0.2s ease;
  }

  .nav-btn:hover {
    background-color: var(--color-bg);
    border-color: var(--color-text);
  }

  /* ── Narrative Breakdown ── */
  .case-study-narrative {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
    padding-bottom: var(--space-12);
    border-bottom: 1px solid var(--color-border);
    margin-bottom: var(--space-12);
  }

  @media (min-width: 768px) {
    .case-study-narrative {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-8);
    }
  }

  .narrative-block {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    padding: var(--space-6);
    border-radius: 4px;
  }

  .narrative-label {
    letter-spacing: var(--ls-wide);
    color: var(--color-text-sec);
    margin-bottom: var(--space-3);
    font-weight: 500;

  }

  .narrative-text {
    line-height: 1.75;
    color: var(--color-text);
  }

  /* ── Footer Navigation ── */
  .next-project-footer {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding-bottom: var(--space-16);
  }

  .next-project-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    text-decoration: none;
    color: var(--color-text);
    padding: var(--space-4) 0;
    border-bottom: 1px solid var(--color-border);
    transition: color 0.3s ease;
  }

  .next-project-link:hover {
    color: var(--color-text-sec);
  }

  .next-title {
    font-family: var(--font-headline);
    font-size: clamp(1.25rem, 3vw, 2rem);
    font-weight: 700;
  }

  .next-arrow {
    font-size: 1.75rem;
    transition: transform 0.3s ease;
  }

  .next-project-link:hover .next-arrow {
    transform: translateX(6px);
  }
</style>

<script>
  import EmblaCarousel from 'embla-carousel';

  class ProjectGallery extends HTMLElement {
    connectedCallback() {
      const viewportNode = this.querySelector('[data-embla-viewport]') as HTMLElement;
      if (!viewportNode) return;

      const emblaApi = EmblaCarousel(viewportNode, { loop: true });
      
      const prevBtn = this.querySelector('[data-prev]');
      const nextBtn = this.querySelector('[data-next]');
      const indicator = this.querySelector('[data-indicator]');
      
      if (prevBtn) prevBtn.addEventListener('click', () => emblaApi.scrollPrev());
      if (nextBtn) nextBtn.addEventListener('click', () => emblaApi.scrollNext());
      
      const updateIndicator = () => {
        if (indicator) {
          indicator.textContent = `${emblaApi.selectedScrollSnap() + 1} / ${emblaApi.scrollSnapList().length}`;
        }
      };
      
      emblaApi.on('select', updateIndicator);
      emblaApi.on('reInit', updateIndicator);
      updateIndicator();
    }
  }

  if (!customElements.get('project-gallery')) {
    customElements.define('project-gallery', ProjectGallery);
  }
</script>
