---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Journey from '../components/Journey.astro';
import FeaturedProjectCard from '../components/FeaturedProjectCard.astro';
import ArchiveGrid from '../components/ArchiveGrid.astro';
import Experiments from '../components/Experiments.astro';
import SkillList from '../components/SkillList.astro';
import Contact from '../components/Contact.astro';
import ChapterNumber from '../components/ChapterNumber.astro';
import { featuredProjects } from '../data/projectsData';

// Top 3 featured recent projects for homepage
const recentFeatured = featuredProjects.filter((p) => p.isFeatured);
---

<BaseLayout>
  <main>
    <!-- 01 — Hero (UNTOUCHED 100%) -->
    <Hero />

    <!-- 02 — About & Journey -->
    <Journey />

    <!-- 03 — Featured Works & Recent Case Studies -->
    <section id="projects" class="section border-top">
      <div class="container">
        <div class="reveal projects-header">
          <ChapterNumber number="03" label="Featured Works" />
          <h2 class="headline headline--section">Recent Case Studies</h2>
        </div>

        <!-- 3 Featured Visual Cards Grid -->
        <div class="featured-grid">
          {recentFeatured.map((project) => (
            <FeaturedProjectCard
              slug={project.slug}
              chapter={project.chapter}
              title={project.title}
              tagline={project.tagline}
              tools={project.tools}
              coverImage={project.coverImage}
            />
          ))}
        </div>

        <!-- All Projects Dropdown Accordion Section -->
        <div class="all-projects-dropdown reveal">
          <details class="projects-dropdown">
            <summary class="dropdown-trigger">
              <span class="text-mono-sm">LIHAT SEMUA PROYEK & ARSIP (DROPDOWN)</span>
              <span class="dropdown-icon">+</span>
            </summary>

            <div class="dropdown-content">
              <ArchiveGrid />
            </div>
          </details>
        </div>

      </div>
    </section>

    <!-- 04 — Experiments -->
    <Experiments />

    <!-- 05 — Expertise & Credentials (Skills Bento Grid) -->
    <SkillList />

    <!-- 06 — Contact & Footer -->
    <Contact />
  </main>
</BaseLayout>

<style>
  .projects-header {
    margin-bottom: var(--space-8);
  }

  /* ── 3 Featured Visual Cards Grid ── */
  .featured-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
    margin-bottom: var(--space-12);
  }

  @media (min-width: 768px) {
    .featured-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-6);
    }
  }

  /* ── All Projects Dropdown ── */
  .all-projects-dropdown {
    margin-top: var(--space-8);
  }

  .projects-dropdown {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 4px;
    overflow: hidden;
  }

  .dropdown-trigger {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-4) var(--space-6);
    cursor: pointer;
    user-select: none;
    list-style: none;
    transition: background-color var(--duration-hover) var(--ease-editorial);
  }

  .dropdown-trigger::-webkit-details-marker {
    display: none;
  }

  .dropdown-trigger:hover {
    background-color: var(--color-bg);
  }

  .dropdown-icon {
    font-family: var(--font-mono);
    font-size: 1.25rem;
    color: var(--color-text);
    transition: transform 0.3s ease;
  }

  details[open] .dropdown-icon {
    transform: rotate(45deg);
  }

  .dropdown-content {
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border);
  }
</style>
