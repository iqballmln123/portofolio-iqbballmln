---
import Navbar from '../components/Navbar.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Mochamad Iqbal Maulana — Software & IoT Engineer',
  description = 'Portofolio Mochamad Iqbal Maulana. Membangun sistem dari sensor sampai layar — mobile, IoT, dan jaringan. Android (Kotlin/Jetpack Compose), embedded systems (ESP32), infrastruktur jaringan.',
} = Astro.props;

const canonicalUrl = Astro.url.href;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content="id_ID" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!-- Fonts: Fraunces (serif display), Inter (body), JetBrains Mono (labels) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400..900;1,9..144,400..900&family=Inter:wght@400;500;600&family=JetBrains+Mono:ital,wght@0,400;0,500;1,400&display=swap"
      rel="stylesheet"
    />

    <!-- Structured Data: Person -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "ProfilePage",
      "mainEntity": {
        "@type": "Person",
        "name": "Mochamad Iqbal Maulana",
        "jobTitle": "Software & IoT Engineer",
        "email": "iqballmaulana1233@gmail.com",
        "url": canonicalUrl,
        "sameAs": [
          "https://www.linkedin.com/in/mochamad-iqbal-maulana-077045297/"
        ],
        "knowsAbout": [
          "Android Development", "Kotlin", "Jetpack Compose",
          "IoT", "ESP32", "Firebase", "Network Engineering"
        ],
        "alumniOf": {
          "@type": "CollegeOrUniversity",
          "name": "Telkom University"
        }
      }
    })} />

    <!-- Styles -->
    <style is:global>
      @import '../styles/global.css';
    </style>
  </head>
  <body>
    <!-- Ambient Background System -->
    <div class="ambient-bg" aria-hidden="true">
      <div class="ambient-grid"></div>
      <div class="ambient-noise"></div>
    </div>

    <!-- Cursor Spotlight Overlay -->
    <div class="cursor-spotlight" id="cursor-spotlight" aria-hidden="true"></div>

    <Navbar />
    <slot />

    <!-- GSAP Global Interactions -->
    <script>
      import { gsap } from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';

      gsap.registerPlugin(ScrollTrigger);

      document.addEventListener('DOMContentLoaded', () => {
        const mm = gsap.matchMedia();

        mm.add(
          {
            isDesktop: '(min-width: 768px)',
            isMobile: '(max-width: 767px)',
            reduceMotion: '(prefers-reduced-motion: reduce)',
          },
          (context) => {
            const { reduceMotion, isDesktop } = context.conditions!;
            const duration = reduceMotion ? 0 : 0.7;
            const yOffset = reduceMotion ? 0 : 30;

            // ──────────────────────────────────────────
            // 1. Spotlight Cursor Follow (Desktop)
            // ──────────────────────────────────────────
            const spotlight = document.getElementById('cursor-spotlight');
            if (spotlight && isDesktop && !reduceMotion) {
              let mouseX = window.innerWidth / 2;
              let mouseY = window.innerHeight / 2;
              let spotX = mouseX;
              let spotY = mouseY;

              window.addEventListener('mousemove', (e) => {
                mouseX = e.clientX;
                mouseY = e.clientY;
              });

              gsap.ticker.add(() => {
                spotX += (mouseX - spotX) * 0.1;
                spotY += (mouseY - spotY) * 0.1;
                gsap.set(spotlight, { x: spotX, y: spotY });
              });
            }

            // ──────────────────────────────────────────
            // 2. Hero entrance stagger (UNTOUCHED 100%)
            // ──────────────────────────────────────────
            const heroEls = document.querySelectorAll('#hero .reveal');
            if (heroEls.length) {
              gsap.set(heroEls, { autoAlpha: 0, y: reduceMotion ? 0 : 40 });
              gsap.to(heroEls, {
                autoAlpha: 1,
                y: 0,
                duration: reduceMotion ? 0 : 1,
                ease: 'power3.out',
                stagger: 0.15,
                delay: 0.2,
              });
            }

            // ──────────────────────────────────────────
            // 3. Batch reveal for all non-hero .reveal elements
            // ──────────────────────────────────────────
            const otherReveals = document.querySelectorAll(
              '.reveal:not(#hero .reveal)'
            );
            if (otherReveals.length) {
              gsap.set(otherReveals, { autoAlpha: 0, y: yOffset });

              ScrollTrigger.batch(otherReveals, {
                onEnter: (elements: Element[]) => {
                  gsap.to(elements, {
                    autoAlpha: 1,
                    y: 0,
                    duration: duration,
                    ease: 'power2.out',
                    stagger: 0.1,
                    overwrite: true,
                  });
                },
                start: 'top 88%',
                once: true,
              });
            }

            // Refresh ScrollTrigger after fonts loaded
            if (document.fonts) {
              document.fonts.ready.then(() => {
                ScrollTrigger.refresh();
              });
            }
          }
        );
      });
    </script>
  </body>
</html>
